# JARVIS Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (default: gpt-4o)
JARVIS_MODEL=gpt-4o

# Memory database path (default: ~/.jarvis/memory.db)
JARVIS_MEMORY_DB=~/.jarvis/memory.db

# Maximum conversation history to include in context (default: 20)
JARVIS_MAX_HISTORY=20

# Maximum long-term memory entries to retrieve per query (default: 5)
JARVIS_MAX_MEMORIES=5

# User name (optional, JARVIS will learn it automatically)
JARVIS_USER_NAME=

# Language preference: 'ar' for Arabic, 'en' for English, 'auto' for auto-detect
JARVIS_LANGUAGE=auto

# Enable/disable tools
JARVIS_ENABLE_WEB_SEARCH=true
JARVIS_ENABLE_CODE_EXEC=true
JARVIS_ENABLE_FILE_OPS=true
